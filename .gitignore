weights/*
!weights/.gitkeep
!weights/best.pt

# ---- run outputs
runs/*
!runs/.gitkeep
*.mp4
*.avi
*.zip

# ---- generated texture cache
assets/textures/.cache/

# ---- local scratch
Claude outputs/
_*.py
