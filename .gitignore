# ---- Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/

# ---- editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ---- large or private data (do NOT upload surgical videos)
data/*
!data/.gitkeep

# ---- voice model (download, see README)
models/*
!models/.gitkeep

# ---- model weights: only best.pt is uploaded (~23 MB).
